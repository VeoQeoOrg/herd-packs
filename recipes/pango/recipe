name: pango
version: 1.58.2
source: https://download.gnome.org/sources/pango/1.58/pango-1.58.2.tar.xz
sha256: 342385b6ca3b7c73455d7c80a13b7dbe4489e00bc3bd4c5bd6ed4dce421e374a
license: LGPL-2.1-or-later
summary: text layout and rendering, with cairo, fontconfig and HarfBuzz
depends: cervus-libc glib harfbuzz fribidi fontconfig freetype cairo
build: |
  printf "[constants]\nstaging = '%s'\n" "$STAGING" > constants.ini
  meson setup build --native-file $RECIPEDIR/../meson-native.ini --cross-file $RECIPEDIR/../meson-cross.ini --cross-file constants.ini \
      --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nofallback \
      -Dintrospection=disabled -Ddocumentation=false -Dgtk_doc=false -Dman-pages=false \
      -Dbuild-testsuite=false -Dbuild-examples=false -Dfontconfig=enabled -Dfreetype=enabled \
      -Dcairo=enabled -Dxft=disabled -Dlibthai=disabled -Dsysprof=disabled
  ninja -C build
  DESTDIR=$PKGDIR meson install -C build --no-rebuild
