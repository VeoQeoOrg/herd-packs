name: xz
version: 5.8.4
source: https://github.com/tukaani-project/xz/releases/download/v5.8.4/xz-5.8.4.tar.xz
sha256: 4ce24038fd4221e0d13bc1a2de7a4db56e90b92b3bf75321f6c14be73f65de4b
license: 0BSD
summary: XZ Utils: the xz and lzma compressors and the liblzma library
depends: cervus-libc
build: |
  sh $RECIPEDIR/../cervus-autotools.sh
  ./configure --host=x86_64-cervus --build=x86_64-pc-linux-gnu --prefix=/usr \
      --disable-nls --disable-doc --enable-shared --enable-static
  make -j16
  make DESTDIR=$PKGDIR install
  rm -rf $PKGDIR/usr/share/man $PKGDIR/usr/share/doc
