name: pixman
version: 0.46.4
source: https://gitlab.freedesktop.org/pixman/pixman
revision: pixman-0.46.4
license: MIT
summary: low-level pixel manipulation, the software renderer behind Weston
depends: libc
build: |
  printf "[constants]\nstaging = '%s'\n" "$STAGING" > constants.ini
  meson setup build --cross-file $RECIPEDIR/../meson-cross.ini --cross-file constants.ini \
      --prefix=/usr --libdir=lib --buildtype=release \
      -Dtls=disabled -Dgtk=disabled -Dlibpng=disabled -Dtests=disabled -Ddemos=disabled -Dopenmp=disabled
  ninja -C build
  DESTDIR=$PKGDIR meson install -C build --no-rebuild
