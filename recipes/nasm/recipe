name: nasm
version: 2.16.03
source: https://github.com/netwide-assembler/nasm/archive/refs/tags/nasm-2.16.03.tar.gz
sha256: e525fa6fdc3df33cec6b499111f44afa78ce50bf260158580dcf014015a21ba9
license: BSD-2-Clause
summary: the Netwide Assembler, an x86 assembler
depends: libc
patches: 0001-config.sub-recognise-cervus.patch
build: |
  sh autogen.sh
  ./configure --host=x86_64-cervus --prefix=/usr
  make
  make DESTDIR=$PKGDIR install-bin
  x86_64-cervus-strip $PKGDIR/usr/bin/nasm $PKGDIR/usr/bin/ndisasm
