diff --color -ruN -x build a/src/unix/cervus.c b/src/unix/cervus.c
--- a/src/unix/cervus.c	1970-01-01 03:00:00.000000000 +0300
+++ b/src/unix/cervus.c	2026-09-26 15:45:12.334611453 +0300
@@ -0,0 +1,102 @@
+#include "uv.h"
+#include "internal.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int uv_exepath(char* buffer, size_t* size) {
+  ssize_t n;
+
+  if (buffer == NULL || size == NULL || *size == 0)
+    return UV_EINVAL;
+
+  n = readlink("/proc/self/exe", buffer, *size - 1);
+  if (n < 0)
+    return UV__ERR(errno);
+
+  buffer[n] = '\0';
+  *size = (size_t) n;
+  return 0;
+}
+
+static uint64_t meminfo_kb(const char* key) {
+  char buf[512];
+  const char* p;
+  unsigned long long v;
+
+  if (uv__slurp("/proc/meminfo", buf, sizeof(buf)))
+    return 0;
+  p = strstr(buf, key);
+  if (p == NULL)
+    return 0;
+  if (sscanf(p + strlen(key), " %llu", &v) != 1)
+    return 0;
+  return (uint64_t) v * 1024;
+}
+
+uint64_t uv_get_free_memory(void) {
+  return meminfo_kb("MemFree:");
+}
+
+uint64_t uv_get_total_memory(void) {
+  return meminfo_kb("MemTotal:");
+}
+
+uint64_t uv_get_constrained_memory(void) {
+  return uv__get_rlimit_max_memory();
+}
+
+uint64_t uv_get_available_memory(void) {
+  return uv_get_free_memory();
+}
+
+int uv_resident_set_memory(size_t* rss) {
+  *rss = 0;
+  return 0;
+}
+
+int uv_uptime(double* uptime) {
+  char buf[128];
+
+  if (uv__slurp("/proc/uptime", buf, sizeof(buf)) == 0 &&
+      sscanf(buf, "%lf", uptime) == 1)
+    return 0;
+  return UV__ERR(EIO);
+}
+
+void uv_loadavg(double avg[3]) {
+  char buf[128];
+
+  avg[0] = avg[1] = avg[2] = 0;
+  if (uv__slurp("/proc/loadavg", buf, sizeof(buf)) == 0)
+    sscanf(buf, "%lf %lf %lf", &avg[0], &avg[1], &avg[2]);
+}
+
+int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
+  long n;
+  int i;
+
+  n = sysconf(_SC_NPROCESSORS_ONLN);
+  if (n < 1)
+    n = 1;
+
+  *cpu_infos = uv__calloc(n, sizeof(**cpu_infos));
+  if (*cpu_infos == NULL) {
+    *count = 0;
+    return UV_ENOMEM;
+  }
+
+  for (i = 0; i < n; i++) {
+    (*cpu_infos)[i].model = uv__strdup("x86_64");
+    if ((*cpu_infos)[i].model == NULL) {
+      uv_free_cpu_info(*cpu_infos, i);
+      *cpu_infos = NULL;
+      *count = 0;
+      return UV_ENOMEM;
+    }
+  }
+
+  *count = (int) n;
+  return 0;
+}
