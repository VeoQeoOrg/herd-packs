name: llvm
version: 23.1.3
source: https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.3/llvm-project-23.1.3.src.tar.xz
sha256: c44186a7762ed28954be72e5ff6df9808e0779d4f1bf014ecc4e7e211d31ee34
license: Apache-2.0 WITH LLVM-exception
summary: LLVM with clang and lld: C and C++ compilers and a linker that run on Cervus and target it
depends: cervus-libc gcc zlib
builddeps: zlib
patches: 0001-add-the-cervus-operating-system.patch
build: |
  cmake -G Ninja -S llvm -B host -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_C_COMPILER=cc -DCMAKE_CXX_COMPILER=c++ \
      -DLLVM_ENABLE_PROJECTS="clang;lld" -DLLVM_TARGETS_TO_BUILD=X86 \
      -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF
  ninja -C host llvm-tblgen llvm-min-tblgen clang-tblgen
  cmake -G Ninja -S llvm -B build -DCMAKE_TOOLCHAIN_FILE=$RECIPEDIR/../cmake-cross.cmake \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
      -DLLVM_ENABLE_PROJECTS="clang;lld" -DLLVM_TARGETS_TO_BUILD=X86 \
      -DLLVM_HOST_TRIPLE=x86_64-cervus -DLLVM_DEFAULT_TARGET_TRIPLE=x86_64-cervus \
      -DLLVM_NATIVE_TOOL_DIR=$PWD/host/bin \
      -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON -DCLANG_LINK_CLANG_DYLIB=ON \
      -DLLVM_INSTALL_TOOLCHAIN_ONLY=ON \
      -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF \
      -DLLVM_INCLUDE_DOCS=OFF -DLLVM_ENABLE_ZLIB=FORCE_ON -DLLVM_ENABLE_ZSTD=OFF \
      -DLLVM_ENABLE_LIBXML2=OFF -DLLVM_ENABLE_LIBEDIT=OFF -DLLVM_ENABLE_LIBPFM=OFF
  ninja -C build
  DESTDIR=$PKGDIR ninja -C build install
