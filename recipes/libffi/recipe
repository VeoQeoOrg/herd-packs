name: libffi
version: 3.8.0
source: https://github.com/libffi/libffi
revision: v3.8.0
license: MIT
summary: a portable foreign function interface library
depends: libc
patches: 0001-config.sub-recognise-cervus.patch
build: |
  ./autogen.sh
  ./configure --host=x86_64-cervus --prefix=/usr --disable-shared --enable-static \
              --disable-docs --disable-multi-os-directory
  make -j8
  make install DESTDIR=$PKGDIR
  rm -rf $PKGDIR/usr/share
