name: curl
version: 8.22.0
source: https://curl.se/download/curl-8.22.0.tar.xz
sha256: f7ef3ae8a22e521f289803fe93543eb64c329b58aa73a9e224dfd915a2a5f4f7
license: curl
summary: curl and libcurl: transfers over HTTP, HTTPS, FTP and more, with OpenSSL
depends: cervus-libc openssl zlib
builddeps: openssl zlib
build: |
  sh $RECIPEDIR/../cervus-config-sub.sh
  ./configure --host=x86_64-cervus --build=x86_64-pc-linux-gnu --prefix=/usr \
      --with-openssl=$DEPDIR/usr --with-zlib=$DEPDIR/usr \
      --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt --with-ca-path=/etc/ssl/certs \
      --without-libpsl --without-brotli --without-zstd --without-nghttp2 --without-libidn2 \
      --without-libssh2 --disable-ldap --disable-ldaps --disable-rtsp --disable-dict \
      --disable-docs --disable-manual --enable-static --enable-shared \
      CPPFLAGS="-I$DEPDIR/usr/include" LDFLAGS="-L$DEPDIR/usr/lib"
  make -j16
  make DESTDIR=$PKGDIR install
  rm -rf $PKGDIR/usr/share/man
