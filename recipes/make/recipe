name: make
version: 4.4.1
source: https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz
sha256: dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3
license: GPL-3.0-or-later
summary: GNU make, the build automation tool
depends: libc
patches: 0001-config.sub-recognise-cervus.patch 0002-findprog-include-stdbool.patch
build: |
  ./configure --host=x86_64-cervus --prefix=/usr --disable-nls --without-guile
  make CFLAGS="-std=gnu17 -O2"
  make DESTDIR=$PKGDIR install
  rm -rf $PKGDIR/usr/share/info
  x86_64-cervus-strip $PKGDIR/usr/bin/make
