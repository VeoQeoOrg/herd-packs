name: mtools
version: 4.0.49
source: https://ftp.gnu.org/gnu/mtools/mtools-4.0.49.tar.gz
sha256: 10cd1111da87bf2400a380c1639a6cba8bfb937a24f9c51f5f88d393ae5f6f76
license: GPL-3.0-or-later
summary: utilities to access FAT file systems and images without mounting them
depends: libc
build: |
  sh $RECIPEDIR/../cervus-autotools.sh .
  ./configure --host=x86_64-cervus --prefix=/usr --sysconfdir=/etc --disable-floppyd --without-x
  make -j8
  make DESTDIR=$PKGDIR install
  rm -rf $PKGDIR/usr/share/info
