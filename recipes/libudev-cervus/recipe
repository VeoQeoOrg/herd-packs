name: libudev-cervus
version: 1.0
source: (none: written for Cervus)
revision: -
license: GPL-3.0
summary: the libudev interface on Cervus: enumerates /dev/dri and /dev/input for libinput and Weston
depends: libc
extra: libudev.c libudev.h libudev.pc
build: |
  x86_64-cervus-gcc -O2 -fPIC -fvisibility=hidden -I$RECIPEDIR -c $RECIPEDIR/libudev.c -o libudev.o
  x86_64-cervus-gcc -shared -Wl,-soname,libudev.so.1 libudev.o -o libudev.so.1.7.0
  mkdir -p $PKGDIR/usr/lib/pkgconfig $PKGDIR/usr/include
  cp libudev.so.1.7.0 $PKGDIR/usr/lib/
  ln -s libudev.so.1.7.0 $PKGDIR/usr/lib/libudev.so.1
  ln -s libudev.so.1 $PKGDIR/usr/lib/libudev.so
  cp $RECIPEDIR/libudev.h $PKGDIR/usr/include/
  cp $RECIPEDIR/libudev.pc $PKGDIR/usr/lib/pkgconfig/
