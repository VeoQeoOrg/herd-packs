diff --git a/clients/terminal.c b/clients/terminal.c
index 7acd89a..606ff9d 100644
--- a/clients/terminal.c
+++ b/clients/terminal.c
@@ -488,8 +488,57 @@ struct terminal {
 	int selection_end_row, selection_end_col;
 	struct wl_list link;
 	int pace_pipe;
+	int cursor_shape;
+	int cursor_blink;
+	int cursor_on;
+	int cursor_timer_ready;
+	struct toytimer cursor_timer;
 };
 
+enum {
+	CURSOR_BLOCK,
+	CURSOR_UNDERLINE,
+	CURSOR_BAR
+};
+
+static void
+terminal_cursor_poke(struct terminal *terminal)
+{
+	struct itimerspec its = {
+		.it_interval = { 0, 530000000 },
+		.it_value = { 0, 530000000 },
+	};
+
+	terminal->cursor_on = 1;
+	if (!terminal->cursor_timer_ready)
+		return;
+	if (terminal->cursor_blink)
+		toytimer_arm(&terminal->cursor_timer, &its);
+	else
+		toytimer_disarm(&terminal->cursor_timer);
+}
+
+static void
+terminal_set_cursor_style(struct terminal *terminal, int style)
+{
+	if (style < 0 || style > 6)
+		return;
+	terminal->cursor_shape = style <= 2 ? CURSOR_BLOCK :
+				 style <= 4 ? CURSOR_UNDERLINE : CURSOR_BAR;
+	terminal->cursor_blink = style == 0 || (style % 2) == 1;
+	terminal_cursor_poke(terminal);
+}
+
+static void
+cursor_blink_func(struct toytimer *tt)
+{
+	struct terminal *terminal =
+		container_of(tt, struct terminal, cursor_timer);
+
+	terminal->cursor_on = !terminal->cursor_on;
+	window_schedule_redraw(terminal->window);
+}
+
 /* Create default tab stops, every 8 characters */
