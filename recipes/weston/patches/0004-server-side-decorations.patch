+WL_EXPORT struct weston_buffer_reference *
+weston_buffer_create_image(struct weston_compositor *compositor,
+			   int32_t width, int32_t height)
+{
+	struct weston_buffer_reference *ret;
+	struct weston_buffer *buffer;
+
+	if (width <= 0 || height <= 0)
+		return NULL;
+
+	ret = zalloc(sizeof(*ret));
+	if (!ret)
+		return NULL;
+
+	buffer = zalloc(sizeof(*buffer));
+	if (!buffer) {
+		free(ret);
+		return NULL;
+	}
+
+	buffer->image_data = zalloc((size_t)width * (size_t)height * 4);
+	if (!buffer->image_data) {
+		free(buffer);
+		free(ret);
+		return NULL;
+	}
+
+	wl_signal_init(&buffer->destroy_signal);
+	buffer->type = WESTON_BUFFER_IMAGE;
+	buffer->width = width;
+	buffer->height = height;
+	buffer->stride = width * 4;
+	buffer->buffer_origin = ORIGIN_TOP_LEFT;
+	buffer->pixel_format = pixel_format_get_info_shm(WL_SHM_FORMAT_ARGB8888);
+	buffer->format_modifier = DRM_FORMAT_MOD_LINEAR;
+	buffer->format_modifier_name = pixel_format_get_modifier(buffer->format_modifier);
+
+	weston_buffer_reference(ret, buffer, BUFFER_MAY_BE_ACCESSED);
+
+	return ret;
+}
+
+WL_EXPORT void
+weston_surface_attach_image(struct weston_surface *surface,
+			    struct weston_buffer_reference *buffer_ref)
+{
+	struct weston_buffer *buffer = buffer_ref->buffer;
+	struct weston_paint_node *pnode;
+
+	assert(buffer);
+	assert(buffer->type == WESTON_BUFFER_IMAGE);
+	weston_buffer_reference(&surface->buffer_ref, buffer,
+				BUFFER_MAY_BE_ACCESSED);
+	wl_list_for_each(pnode, &surface->paint_node_list, surface_link)
+		pnode->status |= WESTON_PAINT_NODE_BUFFER_DIRTY |
+				 WESTON_PAINT_NODE_BUFFER_PARAMS_DIRTY;
+
+	weston_surface_set_size(surface, buffer->width, buffer->height);
+
+	pixman_region32_fini(&surface->opaque);
+	pixman_region32_init(&surface->opaque);
+	surface->is_opaque = false;
+
+	surface->pending.status |=
+		WESTON_SURFACE_DIRTY_BUFFER | WESTON_SURFACE_DIRTY_BUFFER_PARAMS |
+		WESTON_SURFACE_DIRTY_SIZE;
+	pixman_region32_union_rect(&surface->damage, &surface->damage,
+				   0, 0, buffer->width, buffer->height);
+	weston_compositor_schedule_repaint(surface->compositor);
+}
+
+WL_EXPORT void
+weston_buffer_destroy_image(struct weston_buffer_reference *buffer_ref)
+{
+	assert(buffer_ref);
+	assert(buffer_ref->buffer);
+	assert(buffer_ref->buffer->type == WESTON_BUFFER_IMAGE);
+	weston_buffer_reference(buffer_ref, NULL, BUFFER_WILL_NOT_BE_ACCESSED);
+	free(buffer_ref);
+}
