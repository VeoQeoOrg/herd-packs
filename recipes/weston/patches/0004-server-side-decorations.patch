+WL_EXPORT void
+weston_pointer_set_cursor_surface(struct weston_pointer *pointer,
+				  struct weston_surface *surface,
+				  int32_t hotspot_x, int32_t hotspot_y)
+{
+	if (!surface) {
+		if (pointer->sprite)
+			pointer_unmap_sprite(pointer);
+		return;
+	}
+
+	if (pointer->sprite && pointer->sprite->surface == surface &&
+	    pointer->hotspot.c.x == hotspot_x && pointer->hotspot.c.y == hotspot_y)
+		return;
+
+	if (!pointer->sprite || pointer->sprite->surface != surface) {
+		if (pointer->sprite)
+			pointer_unmap_sprite(pointer);
+		wl_signal_add(&surface->destroy_signal,
+			      &pointer->sprite_destroy_listener);
+		surface->committed = pointer_cursor_surface_committed;
+		surface->committed_private = pointer;
+		weston_surface_set_label_static(surface, "cursor");
+		pointer->sprite = weston_view_create(surface);
+	}
+
+	pointer->hotspot = weston_coord_surface(hotspot_x, hotspot_y, surface);
+
+	if (surface->width != 0) {
+		struct weston_coord_surface zero;
+
+		zero = weston_coord_surface(0, 0, surface);
+		pointer_cursor_surface_committed(surface, zero);
+		weston_view_schedule_repaint(pointer->sprite);
+	}
+}
