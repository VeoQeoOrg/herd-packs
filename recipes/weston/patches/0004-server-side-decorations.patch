+#include "config.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <linux/input.h>
+#include <cairo.h>
+
+#include <libweston/libweston.h>
+#include <libweston/desktop.h>
+
+#include "shell.h"
+#include "shared/cairo-util.h"
+#include "shared/helpers.h"
+#include "xdg-decoration-unstable-v1-server-protocol.h"
+#include "kde-server-decoration-server-protocol.h"
+
+enum {
+	DECO_REQUEST_DEFAULT = 0,
+	DECO_REQUEST_CLIENT = 1,
+	DECO_REQUEST_SERVER = 2,
+};
+
+struct shell_decoration {
+	struct desktop_shell *shell;
+	struct shell_surface *shsurf;
+	struct weston_desktop_surface *pending_ds;
+	struct wl_listener pending_destroy;
+	struct wl_list pending_link;
+	struct wl_resource *xdg;
+	struct wl_resource *kde;
+	uint32_t requested;
+	bool server;
+	struct frame *frame;
+	struct weston_surface *surface;
+	struct weston_view *view;
+	struct weston_buffer_reference *buffer;
+	int32_t buf_w, buf_h;
+	int32_t inner_w, inner_h;
+	struct decoration_grab *grab;
+};
+
+struct decoration_grab {
+	struct weston_pointer_grab grab;
+	struct shell_decoration *deco;
+	uint32_t button;
+};
+
+static void
+decoration_surface_committed(struct weston_surface *surface,
+			     struct weston_coord_surface new_origin)
+{
+}
+
+static void
+surface_damage_all(struct weston_surface *surface)
+{
+	pixman_region32_union_rect(&surface->damage, &surface->damage,
+				   0, 0, surface->width, surface->height);
+	weston_compositor_schedule_repaint(surface->compositor);
+}
+
+static struct shell_decoration *
+decoration_from_view(struct weston_view *view)
+{
+	if (!view || view->surface->committed != decoration_surface_committed)
+		return NULL;
+	return view->surface->committed_private;
+}
+
+struct shell_surface *
+shell_decoration_owner(struct weston_surface *surface)
+{
+	struct shell_decoration *deco;
+
+	if (!surface || surface->committed != decoration_surface_committed)
+		return NULL;
+	deco = surface->committed_private;
+	return deco ? deco->shsurf : NULL;
+}
+
+static void
+decoration_hide(struct shell_decoration *deco)
+{
+	if (deco->surface && weston_surface_is_mapped(deco->surface))
+		weston_surface_unmap(deco->surface);
+}
+
+static void
+decoration_end_grab(struct shell_decoration *deco)
+{
+	struct decoration_grab *grab = deco->grab;
+
+	if (!grab)
+		return;
+	deco->grab = NULL;
+	grab->deco = NULL;
+	weston_pointer_end_grab(grab->grab.pointer);
+	free(grab);
+}
+
+static void
+decoration_free_visuals(struct shell_decoration *deco)
+{
+	decoration_end_grab(deco);
+	if (deco->view) {
+		weston_view_set_attached_below(deco->view, NULL);
+		weston_view_destroy(deco->view);
+		deco->view = NULL;
+	}
+	if (deco->surface) {
+		deco->surface->committed = NULL;
+		deco->surface->committed_private = NULL;
+		weston_surface_unref(deco->surface);
+		deco->surface = NULL;
+	}
+	if (deco->buffer) {
+		weston_buffer_destroy_image(deco->buffer);
+		deco->buffer = NULL;
+	}
+	if (deco->frame) {
+		frame_destroy(deco->frame);
+		deco->frame = NULL;
+	}
+	deco->buf_w = deco->buf_h = 0;
+	deco->inner_w = deco->inner_h = 0;
+}
+
+static void
+decoration_unpend(struct shell_decoration *deco)
+{
+	if (!deco->pending_ds)
+		return;
+	deco->pending_ds = NULL;
+	wl_list_remove(&deco->pending_link);
+	wl_list_init(&deco->pending_link);
+	wl_list_remove(&deco->pending_destroy.link);
+	wl_list_init(&deco->pending_destroy.link);
+}
+
+static void
+decoration_maybe_free(struct shell_decoration *deco)
+{
+	if (deco->xdg || deco->kde)
+		return;
+	decoration_unpend(deco);
+	if (deco->shsurf) {
+		deco->shsurf->decoration = NULL;
+		if (deco->server && deco->shsurf->desktop_surface)
+			weston_desktop_surface_force_configure(deco->shsurf->desktop_surface);
+	}
+	decoration_free_visuals(deco);
+	free(deco);
+}
+
+void
+shell_decoration_surface_destroyed(struct shell_surface *shsurf)
+{
+	struct shell_decoration *deco = shsurf->decoration;
+
+	if (!deco)
+		return;
+	shsurf->decoration = NULL;
+	decoration_free_visuals(deco);
+	deco->shsurf = NULL;
+	if (!deco->xdg && !deco->kde)
+		free(deco);
+}
+
+static bool
+decoration_wants_server(struct shell_decoration *deco)
+{
+	return deco->requested != DECO_REQUEST_CLIENT;
+}
+
+static void
+decoration_send_mode(struct shell_decoration *deco)
+{
+	if (deco->xdg)
+		zxdg_toplevel_decoration_v1_send_configure(deco->xdg,
+			deco->server ? ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE :
+				       ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE);
+	if (deco->kde)
+		org_kde_kwin_server_decoration_send_mode(deco->kde,
+			deco->server ? ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER :
+				       ORG_KDE_KWIN_SERVER_DECORATION_MODE_CLIENT);
+}
+
+static void
+decoration_apply(struct shell_decoration *deco)
+{
+	bool server = decoration_wants_server(deco);
+	bool changed = server != deco->server;
+
+	deco->server = server;
+	decoration_send_mode(deco);
+	if (!deco->shsurf)
+		return;
+	if (!server)
+		decoration_hide(deco);
+	if (changed && deco->shsurf->desktop_surface)
+		weston_desktop_surface_force_configure(deco->shsurf->desktop_surface);
+}
+
+static void
+decoration_pending_toplevel_destroyed(struct wl_listener *listener, void *data)
+{
+	struct shell_decoration *deco =
+		container_of(listener, struct shell_decoration, pending_destroy);
+
+	decoration_unpend(deco);
+}
+
+static struct shell_decoration *
+decoration_find_pending(struct desktop_shell *shell, struct weston_desktop_surface *ds)
+{
+	struct shell_decoration *deco;
+
+	wl_list_for_each(deco, &shell->deco_pending, pending_link)
+		if (deco->pending_ds == ds)
+			return deco;
+	return NULL;
+}
+
+static struct shell_decoration *
+decoration_get(struct desktop_shell *shell, struct weston_desktop_surface *ds,
+	       struct wl_resource *role_resource)
+{
+	struct shell_surface *shsurf = weston_desktop_surface_get_user_data(ds);
+	struct shell_decoration *deco;
+
+	if (shsurf && shsurf->decoration)
+		return shsurf->decoration;
+	if (!shsurf) {
+		deco = decoration_find_pending(shell, ds);
+		if (deco)
+			return deco;
+	}
+	deco = zalloc(sizeof *deco);
+	if (!deco)
+		return NULL;
+	deco->shell = shell;
+	deco->requested = DECO_REQUEST_DEFAULT;
+	wl_list_init(&deco->pending_link);
+	wl_list_init(&deco->pending_destroy.link);
+	if (shsurf) {
+		deco->shsurf = shsurf;
+		shsurf->decoration = deco;
+	} else {
+		deco->pending_ds = ds;
+		wl_list_insert(&shell->deco_pending, &deco->pending_link);
+		deco->pending_destroy.notify = decoration_pending_toplevel_destroyed;
+		wl_resource_add_destroy_listener(role_resource, &deco->pending_destroy);
+	}
+	return deco;
+}
+
+void
+shell_decoration_surface_added(struct desktop_shell *shell, struct shell_surface *shsurf)
+{
+	struct shell_decoration *deco =
+		decoration_find_pending(shell, shsurf->desktop_surface);
+
+	if (!deco)
+		return;
+	decoration_unpend(deco);
+	deco->shsurf = shsurf;
+	shsurf->decoration = deco;
+}
+
+static void
+decoration_render(struct shell_decoration *deco)
+{
+	struct weston_compositor *ec = deco->shell->compositor;
+	int32_t w = frame_width(deco->frame);
+	int32_t h = frame_height(deco->frame);
+	int32_t ix, iy, iw, ih, rx, ry, rw, rh;
+	cairo_surface_t *cs;
+	cairo_t *cr;
+
+	if (w <= 0 || h <= 0)
+		return;
+
+	if (!deco->buffer || deco->buf_w != w || deco->buf_h != h) {
+		struct weston_buffer_reference *nb = weston_buffer_create_image(ec, w, h);
+		struct weston_buffer_reference *old = deco->buffer;
+
+		if (!nb)
+			return;
+		deco->buffer = nb;
+		deco->buf_w = w;
+		deco->buf_h = h;
+		weston_surface_attach_image(deco->surface, nb);
+		if (old)
+			weston_buffer_destroy_image(old);
+
+		frame_input_rect(deco->frame, &rx, &ry, &rw, &rh);
+		frame_interior(deco->frame, &ix, &iy, &iw, &ih);
+		pixman_region32_fini(&deco->surface->input);
+		pixman_region32_init_rect(&deco->surface->input, rx, ry, rw, rh);
+		pixman_region32_t interior;
+		pixman_region32_init_rect(&interior, ix, iy, iw, ih);
+		pixman_region32_subtract(&deco->surface->input, &deco->surface->input, &interior);
+		pixman_region32_fini(&interior);
+	}
+
+	cs = cairo_image_surface_create_for_data(deco->buffer->buffer->image_data,
+						 CAIRO_FORMAT_ARGB32, w, h, w * 4);
+	cr = cairo_create(cs);
+	cairo_set_operator(cr, CAIRO_OPERATOR_CLEAR);
+	cairo_paint(cr);
+	cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+	frame_repaint(deco->frame, cr);
+	frame_interior(deco->frame, &ix, &iy, &iw, &ih);
+	cairo_set_operator(cr, CAIRO_OPERATOR_CLEAR);
+	cairo_rectangle(cr, ix, iy, iw, ih);
+	cairo_fill(cr);
+	cairo_destroy(cr);
+	cairo_surface_flush(cs);
+	cairo_surface_destroy(cs);
+
+	surface_damage_all(deco->surface);
+}
+
+static void
+decoration_sync_flags(struct shell_decoration *deco)
+{
+	struct weston_desktop_surface *ds = deco->shsurf->desktop_surface;
+	const char *title = weston_desktop_surface_get_title(ds);
+
+	if (weston_desktop_surface_get_activated(ds))
+		frame_set_flag(deco->frame, FRAME_FLAG_ACTIVE);
+	else
+		frame_unset_flag(deco->frame, FRAME_FLAG_ACTIVE);
+
+	if (deco->shsurf->state.maximized)
+		frame_set_flag(deco->frame, FRAME_FLAG_MAXIMIZED);
+	else
+		frame_unset_flag(deco->frame, FRAME_FLAG_MAXIMIZED);
+
+	frame_set_title(deco->frame, title ? title : "");
+}
+
+static bool
+decoration_ensure_visuals(struct shell_decoration *deco)
+{
+	struct weston_compositor *ec = deco->shell->compositor;
+
+	if (!deco->frame) {
+		deco->frame = frame_create(deco->shell->deco_theme, 0, 0,
+					   FRAME_BUTTON_ALL, NULL, NULL);
+		if (!deco->frame)
+			return false;
+	}
+	if (!deco->surface) {
+		deco->surface = weston_surface_create(ec, NULL);
+		if (!deco->surface)
+			return false;
+		weston_surface_set_label_static(deco->surface, "window decoration");
+		deco->surface->committed = decoration_surface_committed;
+		deco->surface->committed_private = deco;
+	}
+	if (!deco->view) {
+		deco->view = weston_view_create(deco->surface);
+		if (!deco->view)
+			return false;
+		weston_view_set_attached_below(deco->view, deco->shsurf->view);
+	}
+	return true;
+}
+
+static void
+decoration_update(struct shell_decoration *deco, bool geometry)
+{
+	struct shell_surface *shsurf = deco->shsurf;
+	struct weston_desktop_surface *ds;
+	struct weston_surface *ws;
+	struct weston_geometry geom;
+	int32_t ix, iy;
+
+	if (!shsurf || !deco->server || !shsurf->desktop_surface)
+		return;
+	ds = shsurf->desktop_surface;
+	ws = weston_desktop_surface_get_surface(ds);
+
+	if (weston_desktop_surface_get_fullscreen(ds) ||
+	    !weston_surface_is_mapped(ws)) {
+		decoration_hide(deco);
+		return;
+	}
+
+	if (!decoration_ensure_visuals(deco))
+		return;
+
+	decoration_sync_flags(deco);
+
+	geom = weston_desktop_surface_get_geometry(ds);
+	if (geometry || geom.width != deco->inner_w || geom.height != deco->inner_h) {
+		frame_resize_inside(deco->frame, geom.width, geom.height);
+		deco->inner_w = geom.width;
+		deco->inner_h = geom.height;
+	}
+
+	if (!deco->buffer || (frame_status(deco->frame) & FRAME_STATUS_REPAINT))
+		decoration_render(deco);
+	frame_status_clear(deco->frame, FRAME_STATUS_REPAINT);
+
+	frame_interior(deco->frame, &ix, &iy, NULL, NULL);
+	weston_view_set_rel_position(deco->view,
+				     weston_coord_surface(geom.x - ix, geom.y - iy,
+							  shsurf->view->surface));
+
+	if (!weston_surface_is_mapped(deco->surface)) {
+		weston_surface_map(deco->surface);
+		ws->compositor->view_list_needs_rebuild = true;
+	}
+	weston_view_geometry_dirty(deco->view);
+	weston_view_schedule_repaint(deco->view);
+}
+
+void
+shell_decoration_committed(struct shell_surface *shsurf)
+{
+	if (shsurf->decoration)
+		decoration_update(shsurf->decoration, false);
+}
+
+void
+shell_decoration_state_changed(struct shell_surface *shsurf)
+{
+	struct shell_decoration *deco = shsurf->decoration;
+
+	if (!deco || !deco->frame || !deco->server)
+		return;
+	decoration_update(deco, false);
+}
+
+bool
+shell_decoration_borders(struct shell_surface *shsurf, bool maximized,
+			 int32_t *top, int32_t *bottom,
+			 int32_t *left, int32_t *right)
+{
+	struct shell_decoration *deco = shsurf->decoration;
+	struct theme *t;
+
+	*top = *bottom = *left = *right = 0;
+	if (!deco || !decoration_wants_server(deco))
+		return false;
+	t = deco->shell->deco_theme;
+	if (!t)
+		return false;
+	*top = t->titlebar_height;
+	*bottom = t->width;
+	*left = t->width;
+	*right = t->width;
+	(void)maximized;
+	return true;
+}
+
+static uint32_t
+location_to_edges(enum theme_location loc)
+{
+	switch (loc) {
+	case THEME_LOCATION_RESIZING_TOP: return WESTON_DESKTOP_SURFACE_EDGE_TOP;
+	case THEME_LOCATION_RESIZING_BOTTOM: return WESTON_DESKTOP_SURFACE_EDGE_BOTTOM;
+	case THEME_LOCATION_RESIZING_LEFT: return WESTON_DESKTOP_SURFACE_EDGE_LEFT;
+	case THEME_LOCATION_RESIZING_RIGHT: return WESTON_DESKTOP_SURFACE_EDGE_RIGHT;
+	case THEME_LOCATION_RESIZING_TOP_LEFT: return WESTON_DESKTOP_SURFACE_EDGE_TOP_LEFT;
+	case THEME_LOCATION_RESIZING_TOP_RIGHT: return WESTON_DESKTOP_SURFACE_EDGE_TOP_RIGHT;
+	case THEME_LOCATION_RESIZING_BOTTOM_LEFT: return WESTON_DESKTOP_SURFACE_EDGE_BOTTOM_LEFT;
+	case THEME_LOCATION_RESIZING_BOTTOM_RIGHT: return WESTON_DESKTOP_SURFACE_EDGE_BOTTOM_RIGHT;
+	default: return WESTON_DESKTOP_SURFACE_EDGE_NONE;
+	}
+}
+
+static void
+decoration_local(struct shell_decoration *deco, struct weston_pointer *pointer,
+		 int *x, int *y)
+{
+	struct weston_coord_surface c =
+		weston_coord_global_to_surface(deco->view, pointer->pos);
+
+	*x = (int)c.c.x;
+	*y = (int)c.c.y;
+}
+
+static void
+decoration_repaint_if_needed(struct shell_decoration *deco)
+{
+	if (deco->frame && (frame_status(deco->frame) & FRAME_STATUS_REPAINT)) {
+		decoration_render(deco);
+		frame_status_clear(deco->frame, FRAME_STATUS_REPAINT);
+	}
+}
+
+static void
+decoration_run_actions(struct shell_decoration *deco, struct weston_pointer *pointer,
+		       enum theme_location loc)
+{
+	struct shell_surface *shsurf = deco->shsurf;
+	uint32_t status = frame_status(deco->frame);
+
+	frame_status_clear(deco->frame, FRAME_STATUS_ALL & ~FRAME_STATUS_REPAINT);
+	if (!shsurf)
+		return;
+
+	if (status & FRAME_STATUS_MOVE) {
+		decoration_end_grab(deco);
+		shell_surface_interactive_move(shsurf, pointer);
+	} else if (status & FRAME_STATUS_RESIZE) {
+		decoration_end_grab(deco);
+		shell_surface_interactive_resize(shsurf, pointer, location_to_edges(loc));
+	} else if (status & FRAME_STATUS_CLOSE) {
+		weston_desktop_surface_close(shsurf->desktop_surface);
+	} else if (status & FRAME_STATUS_MAXIMIZE) {
+		shell_surface_toggle_maximized(shsurf);
+	} else if (status & FRAME_STATUS_MINIMIZE) {
+		shell_surface_request_minimize(shsurf);
+	}
+}
+
+static void
+decoration_grab_focus(struct weston_pointer_grab *grab)
+{
+}
+
+static void
+decoration_grab_motion(struct weston_pointer_grab *base,
+		       const struct weston_pointer_motion_event *event)
+{
+	struct decoration_grab *grab = container_of(base, struct decoration_grab, grab);
+	struct weston_pointer *pointer = base->pointer;
+	int x, y;
+
+	weston_pointer_move(pointer, event);
+	if (!grab->deco || !grab->deco->view)
+		return;
+	decoration_local(grab->deco, pointer, &x, &y);
+	frame_pointer_motion(grab->deco->frame, pointer, x, y);
+	decoration_repaint_if_needed(grab->deco);
+}
+
+static void
+decoration_grab_button(struct weston_pointer_grab *base,
+		       const struct weston_pointer_button_event *event)
+{
+	uint32_t button = event->button;
+	uint32_t state = event->button_state;
+	struct decoration_grab *grab = container_of(base, struct decoration_grab, grab);
+	struct weston_pointer *pointer = base->pointer;
+	struct shell_decoration *deco = grab->deco;
+	enum theme_location loc;
+
+	if (!deco) {
+		if (pointer->button_count == 0)
+			weston_pointer_end_grab(pointer);
+		return;
+	}
+	if (button != grab->button || state != WL_POINTER_BUTTON_STATE_RELEASED)
+		return;
+
+	loc = frame_pointer_button(deco->frame, pointer, button,
+				   WL_POINTER_BUTTON_STATE_RELEASED);
+	decoration_repaint_if_needed(deco);
+	decoration_end_grab(deco);
+	decoration_run_actions(deco, pointer, loc);
+}
+
+static void
+decoration_grab_axis(struct weston_pointer_grab *grab,
+		     const struct weston_pointer_axis_event *event)
+{
+}
+
+static void
+decoration_grab_axis_source(struct weston_pointer_grab *grab, uint32_t source)
+{
+}
+
+static void
+decoration_grab_frame(struct weston_pointer_grab *grab)
+{
+}
+
+static void
+decoration_grab_cancel(struct weston_pointer_grab *base)
+{
+	struct decoration_grab *grab = container_of(base, struct decoration_grab, grab);
+
+	if (grab->deco) {
+		grab->deco->grab = NULL;
+		grab->deco = NULL;
+	}
+	weston_pointer_end_grab(base->pointer);
+	free(grab);
+}
+
+static const struct weston_pointer_grab_interface decoration_grab_interface = {
+	decoration_grab_focus,
+	decoration_grab_motion,
+	decoration_grab_button,
+	decoration_grab_axis,
+	decoration_grab_axis_source,
+	decoration_grab_frame,
+	decoration_grab_cancel,
+};
+
+bool
+shell_decoration_button(struct weston_pointer *pointer, uint32_t button)
+{
+	struct shell_decoration *deco = decoration_from_view(pointer->focus);
+	enum theme_location loc;
+	int x, y;
+
+	if (!deco || !deco->frame || !deco->shsurf)
+		return false;
+
+	decoration_local(deco, pointer, &x, &y);
+	frame_pointer_motion(deco->frame, pointer, x, y);
+	loc = frame_pointer_button(deco->frame, pointer, button,
+				   WL_POINTER_BUTTON_STATE_PRESSED);
+	decoration_repaint_if_needed(deco);
+
+	if (frame_status(deco->frame) & (FRAME_STATUS_MOVE | FRAME_STATUS_RESIZE)) {
+		decoration_run_actions(deco, pointer, loc);
+		return true;
+	}
+
+	if (!deco->grab) {
+		struct decoration_grab *grab = zalloc(sizeof *grab);
+
+		if (!grab)
+			return true;
+		grab->deco = deco;
+		grab->button = button;
+		grab->grab.interface = &decoration_grab_interface;
+		deco->grab = grab;
+		weston_pointer_start_grab(pointer, &grab->grab);
+	}
+	return true;
+}
+
+static struct weston_surface *
+decoration_cursor(struct desktop_shell *shell)
+{
+	static const double arrow[][2] = {
+		{ 1, 1 }, { 1, 17 }, { 5, 13 }, { 8, 19 }, { 10, 18 }, { 7, 12 }, { 12, 12 },
+	};
+	struct weston_compositor *ec = shell->compositor;
+	cairo_surface_t *cs;
+	cairo_t *cr;
+
+	if (shell->deco_cursor)
+		return shell->deco_cursor;
+
+	shell->deco_cursor_buffer = weston_buffer_create_image(ec, 16, 22);
+	if (!shell->deco_cursor_buffer)
+		return NULL;
+	shell->deco_cursor = weston_surface_create(ec, NULL);
+	if (!shell->deco_cursor) {
+		weston_buffer_destroy_image(shell->deco_cursor_buffer);
+		shell->deco_cursor_buffer = NULL;
+		return NULL;
+	}
+	cs = cairo_image_surface_create_for_data(shell->deco_cursor_buffer->buffer->image_data,
+						 CAIRO_FORMAT_ARGB32, 16, 22, 16 * 4);
+	cr = cairo_create(cs);
+	cairo_move_to(cr, arrow[0][0], arrow[0][1]);
+	for (unsigned i = 1; i < ARRAY_LENGTH(arrow); i++)
+		cairo_line_to(cr, arrow[i][0], arrow[i][1]);
+	cairo_close_path(cr);
+	cairo_set_source_rgb(cr, 1, 1, 1);
+	cairo_fill_preserve(cr);
+	cairo_set_source_rgb(cr, 0, 0, 0);
+	cairo_set_line_width(cr, 1.2);
+	cairo_stroke(cr);
+	cairo_destroy(cr);
+	cairo_surface_flush(cs);
+	cairo_surface_destroy(cs);
+	weston_surface_attach_image(shell->deco_cursor, shell->deco_cursor_buffer);
+	return shell->deco_cursor;
+}
+
+void
+shell_decoration_pointer_motion(struct desktop_shell *shell, struct weston_pointer *pointer)
+{
+	struct shell_decoration *deco = decoration_from_view(pointer->focus);
+	struct shell_decoration *prev = shell->deco_hover;
+	int x, y;
+
+	if (prev && prev != deco) {
+		if (prev->frame) {
+			frame_pointer_leave(prev->frame, pointer);
+			decoration_repaint_if_needed(prev);
+		}
+		shell->deco_hover = NULL;
+	}
+	if (!deco || !deco->frame || deco->grab)
+		return;
+
+	decoration_local(deco, pointer, &x, &y);
+	if (shell->deco_hover != deco) {
+		struct weston_surface *cursor = decoration_cursor(shell);
+
+		frame_pointer_enter(deco->frame, pointer, x, y);
+		shell->deco_hover = deco;
+		if (cursor)
+			weston_pointer_set_cursor_surface(pointer, cursor, 1, 1);
+	} else {
+		frame_pointer_motion(deco->frame, pointer, x, y);
+	}
+	decoration_repaint_if_needed(deco);
+}
+
+void
+shell_decoration_forget(struct desktop_shell *shell, struct shell_surface *shsurf)
+{
+	if (shell->deco_hover && shell->deco_hover->shsurf == shsurf)
+		shell->deco_hover = NULL;
+}
+
+static void
+xdg_decoration_resource_destroyed(struct wl_resource *resource)
+{
+	struct shell_decoration *deco = wl_resource_get_user_data(resource);
+
+	if (!deco)
+		return;
+	deco->xdg = NULL;
+	if (deco->shell->deco_hover == deco && !deco->kde)
+		deco->shell->deco_hover = NULL;
+	decoration_maybe_free(deco);
+}
+
+static void
+xdg_decoration_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static void
+xdg_decoration_set_mode(struct wl_client *client, struct wl_resource *resource,
+			uint32_t mode)
+{
+	struct shell_decoration *deco = wl_resource_get_user_data(resource);
+
+	if (!deco)
+		return;
+	deco->requested = mode == ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE ?
+			  DECO_REQUEST_CLIENT : DECO_REQUEST_SERVER;
+	decoration_apply(deco);
+}
+
+static void
+xdg_decoration_unset_mode(struct wl_client *client, struct wl_resource *resource)
+{
+	struct shell_decoration *deco = wl_resource_get_user_data(resource);
+
+	if (!deco)
+		return;
+	deco->requested = DECO_REQUEST_DEFAULT;
+	decoration_apply(deco);
+}
+
+static const struct zxdg_toplevel_decoration_v1_interface xdg_decoration_implementation = {
+	xdg_decoration_destroy,
+	xdg_decoration_set_mode,
+	xdg_decoration_unset_mode,
+};
+
+static void
+xdg_manager_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static void
+xdg_manager_get_toplevel_decoration(struct wl_client *client,
+				    struct wl_resource *resource,
+				    uint32_t id,
+				    struct wl_resource *toplevel)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct weston_desktop_surface *ds = NULL;
+	struct shell_decoration *deco;
+	struct wl_resource *res;
+
+	if (toplevel && strcmp(wl_resource_get_class(toplevel), "xdg_toplevel") == 0)
+		ds = wl_resource_get_user_data(toplevel);
+
+	res = wl_resource_create(client, &zxdg_toplevel_decoration_v1_interface,
+				 wl_resource_get_version(resource), id);
+	if (!res) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	if (!ds) {
+		wl_resource_set_implementation(res, &xdg_decoration_implementation,
+					       NULL, NULL);
+		zxdg_toplevel_decoration_v1_send_configure(res,
+			ZXDG_TOPLEVEL_DECORATION_V1_MODE_CLIENT_SIDE);
+		return;
+	}
+	deco = decoration_get(shell, ds, toplevel);
+	if (deco && deco->xdg) {
+		wl_resource_post_error(resource,
+				       ZXDG_TOPLEVEL_DECORATION_V1_ERROR_ALREADY_CONSTRUCTED,
+				       "the toplevel already has a decoration object");
+		wl_resource_destroy(res);
+		return;
+	}
+	if (!deco) {
+		wl_resource_destroy(res);
+		wl_client_post_no_memory(client);
+		return;
+	}
+	deco->xdg = res;
+	wl_resource_set_implementation(res, &xdg_decoration_implementation,
+				       deco, xdg_decoration_resource_destroyed);
+	decoration_apply(deco);
+	weston_desktop_surface_force_configure(ds);
+}
+
+static const struct zxdg_decoration_manager_v1_interface xdg_manager_implementation = {
+	xdg_manager_destroy,
+	xdg_manager_get_toplevel_decoration,
+};
+
+static void
+xdg_manager_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id)
+{
+	struct wl_resource *res = wl_resource_create(client,
+		&zxdg_decoration_manager_v1_interface, MIN(version, 1u), id);
+
+	if (!res) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	wl_resource_set_implementation(res, &xdg_manager_implementation, data, NULL);
+}
+
+static void
+kde_decoration_resource_destroyed(struct wl_resource *resource)
+{
+	struct shell_decoration *deco = wl_resource_get_user_data(resource);
+
+	if (!deco)
+		return;
+	deco->kde = NULL;
+	if (deco->shell->deco_hover == deco && !deco->xdg)
+		deco->shell->deco_hover = NULL;
+	decoration_maybe_free(deco);
+}
+
+static void
+kde_decoration_release(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static void
+kde_decoration_request_mode(struct wl_client *client, struct wl_resource *resource,
+			    uint32_t mode)
+{
+	struct shell_decoration *deco = wl_resource_get_user_data(resource);
+
+	if (!deco)
+		return;
+	deco->requested = mode == ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER ?
+			  DECO_REQUEST_SERVER : DECO_REQUEST_CLIENT;
+	decoration_apply(deco);
+}
+
+static const struct org_kde_kwin_server_decoration_interface kde_decoration_implementation = {
+	kde_decoration_release,
+	kde_decoration_request_mode,
+};
+
+static void
+kde_manager_create(struct wl_client *client, struct wl_resource *resource,
+		   uint32_t id, struct wl_resource *surface_resource)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct weston_surface *surface = wl_resource_get_user_data(surface_resource);
+	struct weston_desktop_surface *ds = weston_surface_get_desktop_surface(surface);
+	struct shell_decoration *deco = NULL;
+	struct wl_resource *res;
+
+	res = wl_resource_create(client, &org_kde_kwin_server_decoration_interface,
+				 wl_resource_get_version(resource), id);
+	if (!res) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	if (ds) {
+		deco = decoration_get(shell, ds, surface_resource);
+		if (deco && deco->kde)
+			deco = NULL;
+	}
+	if (!deco) {
+		wl_resource_set_implementation(res, &kde_decoration_implementation, NULL, NULL);
+		org_kde_kwin_server_decoration_send_mode(res,
+			ORG_KDE_KWIN_SERVER_DECORATION_MODE_CLIENT);
+		return;
+	}
+	deco->kde = res;
+	wl_resource_set_implementation(res, &kde_decoration_implementation,
+				       deco, kde_decoration_resource_destroyed);
+	decoration_apply(deco);
+	if (ds)
+		weston_desktop_surface_force_configure(ds);
+}
+
+static const struct org_kde_kwin_server_decoration_manager_interface kde_manager_implementation = {
+	kde_manager_create,
+};
+
+static void
+kde_manager_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id)
+{
+	struct wl_resource *res = wl_resource_create(client,
+		&org_kde_kwin_server_decoration_manager_interface, MIN(version, 1u), id);
+
+	if (!res) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	wl_resource_set_implementation(res, &kde_manager_implementation, data, NULL);
+	org_kde_kwin_server_decoration_manager_send_default_mode(res,
+		ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER);
+}
+
+void
+shell_decoration_init(struct desktop_shell *shell)
+{
+	wl_list_init(&shell->deco_pending);
+	shell->deco_theme = theme_create();
+	if (!shell->deco_theme)
+		return;
+	wl_global_create(shell->compositor->wl_display,
+			 &zxdg_decoration_manager_v1_interface, 1, shell, xdg_manager_bind);
+	wl_global_create(shell->compositor->wl_display,
+			 &org_kde_kwin_server_decoration_manager_interface, 1, shell, kde_manager_bind);
+}
