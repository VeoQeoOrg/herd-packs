+static void
+terminal_enter_alt(struct terminal *terminal)
+{
+	int i;
+
+	if (terminal->alt_data)
+		return;
+	terminal->alt_data = malloc(terminal->data_pitch * terminal->height);
+	terminal->alt_attr = malloc(terminal->attr_pitch * terminal->height);
+	if (!terminal->alt_data || !terminal->alt_attr) {
+		free(terminal->alt_data);
+		free(terminal->alt_attr);
+		terminal->alt_data = NULL;
+		terminal->alt_attr = NULL;
+		return;
+	}
+	terminal->alt_rows = terminal->height;
+	terminal->alt_data_pitch = terminal->data_pitch;
+	terminal->alt_attr_pitch = terminal->attr_pitch;
+	terminal->alt_row = terminal->row;
+	terminal->alt_column = terminal->column;
+	for (i = 0; i < terminal->height; i++) {
+		memcpy((char *)terminal->alt_data + i * terminal->data_pitch,
+		       terminal_get_row(terminal, i), terminal->data_pitch);
+		memcpy((char *)terminal->alt_attr + i * terminal->attr_pitch,
+		       terminal_get_attr_row(terminal, i), terminal->attr_pitch);
+		memset(terminal_get_row(terminal, i), 0, terminal->data_pitch);
+		attr_init(terminal_get_attr_row(terminal, i),
+			  terminal->curr_attr, terminal->width);
+	}
+}
+
+static void
+terminal_leave_alt(struct terminal *terminal)
+{
+	int i, same;
+
+	if (!terminal->alt_data)
+		return;
+	same = terminal->alt_rows == terminal->height &&
+	       terminal->alt_data_pitch == terminal->data_pitch &&
+	       terminal->alt_attr_pitch == terminal->attr_pitch;
+	for (i = 0; i < terminal->height; i++) {
+		if (same) {
+			memcpy(terminal_get_row(terminal, i),
+			       (char *)terminal->alt_data + i * terminal->data_pitch,
+			       terminal->data_pitch);
+			memcpy(terminal_get_attr_row(terminal, i),
+			       (char *)terminal->alt_attr + i * terminal->attr_pitch,
+			       terminal->attr_pitch);
+		} else {
+			memset(terminal_get_row(terminal, i), 0, terminal->data_pitch);
+			attr_init(terminal_get_attr_row(terminal, i),
+				  terminal->curr_attr, terminal->width);
+		}
+	}
+	if (same) {
+		terminal->row = terminal->alt_row;
+		terminal->column = terminal->alt_column;
+	}
+	if (terminal->row >= terminal->height)
+		terminal->row = terminal->height - 1;
+	if (terminal->column >= terminal->width)
+		terminal->column = terminal->width - 1;
+	free(terminal->alt_data);
+	free(terminal->alt_attr);
+	terminal->alt_data = NULL;
+	terminal->alt_attr = NULL;
+}
