@@ -929,6 +1002,65 @@ struct color_scheme DEFAULT_COLORS = {
 	{7, 0, 0, }                    /* bg:black (0), fg:light gray (7)  */
 };
 
+static struct color_scheme system_colors;
+
+static int
+hex_color(const char *s, struct terminal_color *c)
+{
+	char *end;
+	unsigned long v = strtoul(s, &end, 16);
+
+	if (end == s)
+		return -1;
+	c->r = ((v >> 16) & 0xff) / 255.0;
+	c->g = ((v >> 8) & 0xff) / 255.0;
+	c->b = (v & 0xff) / 255.0;
+	c->a = 1;
+	return 0;
+}
+
+static struct color_scheme *
+load_system_colors(void)
+{
+	FILE *f = fopen("/etc/console.conf", "r");
+	char line[512];
+	int n = 0, have_fg = 0, have_bg = 0;
+	struct terminal_color fg, bg;
+
+	if (!f)
+		return &DEFAULT_COLORS;
+	system_colors = DEFAULT_COLORS;
+	while (fgets(line, sizeof line, f)) {
+		if (!strncmp(line, "palette=", 8)) {
+			char *p = line + 8;
+			for (n = 0; n < 16; n++) {
+				if (hex_color(p, &system_colors.palette[n]) != 0)
+					break;
+				p = strchr(p, ',');
+				if (!p)
+					break;
+				p++;
+			}
+			if (n < 15)
+				n = 0;
+			else
+				n = 16;
+		} else if (!strncmp(line, "fg=", 3)) {
+			have_fg = hex_color(line + 3, &fg) == 0;
+		} else if (!strncmp(line, "bg=", 3)) {
+			have_bg = hex_color(line + 3, &bg) == 0;
+		}
+	}
+	fclose(f);
+	if (n != 16)
+		return &DEFAULT_COLORS;
+	if (have_bg)
+		system_colors.palette[0] = bg;
+	if (have_fg)
+		system_colors.palette[7] = fg;
+	return &system_colors;
+}
