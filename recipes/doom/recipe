name: doom
version: 1.0
source: https://github.com/ozkl/doomgeneric
revision: master
license: GPL-2.0-only
summary: Doom with WASD and mouse: full screen on a text console, a window under Weston
depends: libc freedoom
patches: 0001-skip-SDL_mixer-on-cervus.patch
extra: doomgeneric_cervus.c i_cervussound.c Makefile.cervus
build: |
  cp $RECIPEDIR/doomgeneric_cervus.c $RECIPEDIR/i_cervussound.c \
     $RECIPEDIR/Makefile.cervus doomgeneric/
  cd doomgeneric
  make -f Makefile.cervus -j8
  mkdir -p $PKGDIR/usr/bin
  cp doom $PKGDIR/usr/bin/
  x86_64-cervus-strip $PKGDIR/usr/bin/doom
