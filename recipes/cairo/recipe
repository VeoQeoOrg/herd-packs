name: cairo
version: 1.18.6
source: https://gitlab.freedesktop.org/cairo/cairo
revision: 1.18.6
license: LGPL-2.1 OR MPL-1.1
summary: a 2D graphics library with text through FreeType and fontconfig
depends: pixman libpng zlib freetype fontconfig
build: |
  printf "[constants]\nstaging = '%s'\n" "$STAGING" > constants.ini
  meson setup build --cross-file $RECIPEDIR/../meson-cross.ini --cross-file constants.ini \
      --prefix=/usr --libdir=lib --buildtype=release \
      -Dxlib=disabled -Dxcb=disabled -Dquartz=disabled -Ddwrite=disabled -Dfreetype=enabled \
      -Dfontconfig=enabled -Dpng=enabled -Dzlib=enabled -Dtee=disabled -Dtests=disabled -Dglib=disabled \
      -Dspectre=disabled -Dsymbol-lookup=disabled -Dgtk2-utils=disabled -Dlzo=disabled -Dgtk_doc=false
  ninja -C build
  DESTDIR=$PKGDIR meson install -C build --no-rebuild
