name: gzip
version: 1.15
source: https://ftp.gnu.org/gnu/gzip/gzip-1.15.tar.xz
sha256: 9aa0cc780dec156b8282844833b342ab7cb08c25d2cd9a1869cdd0df31deff48
license: GPL-3.0-or-later
summary: GNU gzip, gunzip and zcat for the gzip compression format
depends: libc
build: |
  sh $RECIPEDIR/../cervus-autotools.sh .
  ./configure --host=x86_64-cervus --prefix=/usr
  make -j8
  make DESTDIR=$PKGDIR install
  rm -rf $PKGDIR/usr/share/info
