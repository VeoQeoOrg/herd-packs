name: wayland
version: 1.26.0
source: https://gitlab.freedesktop.org/wayland/wayland
revision: 1.26.0
license: MIT
summary: 'Wayland: the libraries (shared and static), the wlcomp compositor and the wldemo client'
depends: cervus-libc libffi
extra: wlcomp.c wldemo.c runtimedir.h
build: |
  printf "[constants]\nstaging = '%s'\n" "$STAGING" > constants.ini
  meson setup build --native-file $RECIPEDIR/../meson-native.ini --cross-file $RECIPEDIR/../meson-cross.ini --cross-file constants.ini \
      --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=both \
      -Dscanner=false -Ddocumentation=false -Dtests=false -Ddtd_validation=false
  ninja -C build
  DESTDIR=$PKGDIR meson install -C build --no-rebuild
  mkdir -p $PKGDIR/usr/bin
  x86_64-cervus-gcc -O2 -fPIE -pie -I$RECIPEDIR -I$PKGDIR/usr/include $RECIPEDIR/wlcomp.c \
      -L$PKGDIR/usr/lib -Wl,-rpath-link,$STAGING/usr/lib -lwayland-server -lm -o $PKGDIR/usr/bin/wlcomp
  git clone --depth 1 -b 1.49 https://gitlab.freedesktop.org/wayland/wayland-protocols wp
  wayland-scanner client-header wp/stable/xdg-shell/xdg-shell.xml xdg-shell-client-protocol.h
  wayland-scanner private-code wp/stable/xdg-shell/xdg-shell.xml xdg-shell-protocol.c
  x86_64-cervus-gcc -O2 -fPIE -pie -I. -I$RECIPEDIR -I$PKGDIR/usr/include $RECIPEDIR/wldemo.c \
      xdg-shell-protocol.c -L$PKGDIR/usr/lib -Wl,-rpath-link,$STAGING/usr/lib -lwayland-client -lm -o $PKGDIR/usr/bin/wldemo
