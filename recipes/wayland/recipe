name: wayland
version: 1.26.0-2
source: https://gitlab.freedesktop.org/wayland/wayland
revision: 1.26.0
license: MIT
summary: 'Wayland: the libraries (shared and static), the wlcomp compositor and the wldemo client'
depends: libc
extra: wlcomp.c wldemo.c runtimedir.h
build: |
  git clone -b v3.8.0 https://github.com/libffi/libffi ffi
  (cd ffi && patch -p1 < $RECIPEDIR/../libffi/patches/0001-config.sub-recognise-cervus.patch && ./autogen.sh \
      && ./configure --host=x86_64-cervus --prefix=/usr --disable-shared --enable-static \
                     --disable-docs --disable-multi-os-directory CFLAGS="-O2 -fPIC" \
      && make -j8 && make install DESTDIR=$STAGING)
  printf "[constants]\nstaging = '%s'\n" "$STAGING" > constants.ini
  meson setup build --cross-file $RECIPEDIR/../meson-cross.ini --cross-file constants.ini \
      --prefix=/usr --libdir=lib --buildtype=release -Ddefault_library=both \
      -Dscanner=false -Ddocumentation=false -Dtests=false -Ddtd_validation=false
  ninja -C build
  DESTDIR=$PKGDIR meson install -C build --no-rebuild
  mkdir -p $PKGDIR/usr/bin
  x86_64-cervus-gcc -O2 -fPIE -pie -I$RECIPEDIR -I$PKGDIR/usr/include $RECIPEDIR/wlcomp.c \
      -L$PKGDIR/usr/lib -lwayland-server -lm -o $PKGDIR/usr/bin/wlcomp
  x86_64-cervus-gcc -O2 -fPIE -pie -I$RECIPEDIR -I$PKGDIR/usr/include $RECIPEDIR/wldemo.c \
      -L$PKGDIR/usr/lib -lwayland-client -lm -o $PKGDIR/usr/bin/wldemo
