if(NOT CMAKE_SYSTEM_NAME)
  set(CMAKE_SYSTEM_NAME Linux)
endif()
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/cmake")
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER x86_64-cervus-gcc)
set(CMAKE_CXX_COMPILER x86_64-cervus-g++)
set(CMAKE_AR x86_64-cervus-ar)
set(CMAKE_RANLIB x86_64-cervus-ranlib)
set(CMAKE_STRIP x86_64-cervus-strip)
execute_process(COMMAND ${CMAKE_C_COMPILER} -print-sysroot
                OUTPUT_VARIABLE CERVUS_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE)
set(CMAKE_FIND_ROOT_PATH $ENV{STAGING} ${CERVUS_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_C_FLAGS_INIT "-O2 -I$ENV{STAGING}/usr/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-pie -L$ENV{STAGING}/usr/lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-L$ENV{STAGING}/usr/lib")
