name: glib
version: 2.90.1
source: https://download.gnome.org/sources/glib/2.90/glib-2.90.1.tar.xz
sha256: 93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396
license: LGPL-2.1-or-later
summary: GLib, GObject and GIO: the low-level core library of GNOME and QEMU
depends: cervus-libc pcre2 libffi zlib
patches: 0001-cervus-port.patch
build: |
  printf "[constants]\nstaging = '%s'\n" "$STAGING" > constants.ini
  meson setup build --native-file $RECIPEDIR/../meson-native.ini --cross-file $RECIPEDIR/../meson-cross.ini --cross-file constants.ini \
      --prefix=/usr --libdir=lib --buildtype=release \
      -Dselinux=disabled -Dxattr=false -Dlibmount=disabled -Dman-pages=disabled \
      -Ddocumentation=false -Dtests=false -Dintrospection=disabled -Dsysprof=disabled \
      -Dnls=enabled -Dglib_debug=disabled -Dlibelf=disabled
  ninja -C build
  DESTDIR=$PKGDIR meson install -C build --no-rebuild
