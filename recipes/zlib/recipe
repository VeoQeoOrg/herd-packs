name: zlib
version: 1.3.2
source: https://zlib.net/zlib-1.3.2.tar.gz
sha256: bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
license: Zlib
summary: the zlib compression library and its headers
depends: libc
build: |
  CC=x86_64-cervus-gcc AR=x86_64-cervus-ar RANLIB=x86_64-cervus-ranlib \
      CHOST=x86_64-cervus ./configure --static --prefix=/usr
  make libz.a
  mkdir -p $PKGDIR/usr/lib $PKGDIR/usr/include
  cp libz.a $PKGDIR/usr/lib/
  cp zlib.h zconf.h $PKGDIR/usr/include/
