name: zlib
version: 1.3.2
source: https://zlib.net/zlib-1.3.2.tar.gz
sha256: bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
license: Zlib
summary: the zlib compression library, shared and static, and its headers
depends: cervus-libc
build: |
  cmake -S . -B build -G Ninja -DCMAKE_TOOLCHAIN_FILE=$RECIPEDIR/../cmake-cross.cmake \
      -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DZLIB_BUILD_EXAMPLES=OFF
  ninja -C build
  DESTDIR=$PKGDIR cmake --install build
